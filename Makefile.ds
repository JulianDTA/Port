#---------------------------------------------------------------------------------
# Balatro-DSi devkitARM / libnds Makefile
#---------------------------------------------------------------------------------
.SUFFIXES:

export DEVKITPRO := $(subst \,/,$(DEVKITPRO))
export DEVKITARM := $(subst \,/,$(DEVKITARM))

ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
endif

include $(DEVKITARM)/ds_rules

TARGET      := balatro_dsi
BUILD       := build_ds
SOURCES     := src/core src/platform/ds
INCLUDES    := include

ARCH        := -march=armv5te -mtune=arm946e-s -mthumb -mthumb-interwork

CFLAGS      := -g -Wall -O2 -ffunction-sections -fdata-sections $(ARCH) -DARM9
CFLAGS      += $(INCLUDE)

CXXFLAGS    := $(CFLAGS) -fno-rtti -fno-exceptions
ASFLAGS     := -g $(ARCH)

LDFLAGS     = -specs=ds_arm9.specs -g $(ARCH) $(LIBPATHS) $(LIBS)

LIBS        := -lnds9 -lm
LIBDIRS     := $(LIBNDS)

ifneq ($(BUILD),$(notdir $(CURDIR)))

export ROOTDIR  := $(CURDIR)
export OUTPUT   := $(CURDIR)/$(TARGET)
export VPATH    := $(foreach dir,$(SOURCES),$(CURDIR)/$(dir))
export DEPSDIR  := $(CURDIR)/$(BUILD)

CFILES      := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES    := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
SFILES      := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))

ifeq ($(strip $(CPPFILES)),)
	export LD := $(CC)
else
	export LD := $(CXX)
endif

export OFILES   := $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o)
export INCLUDE  := $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
                   $(foreach dir,$(LIBDIRS),-I$(dir)/include) \
                   -I$(CURDIR)/$(BUILD)

export LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

.PHONY: $(BUILD) clean

$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile.ds

clean:
	@echo "[CLEAN] Removing build files..."
	@rm -rf $(BUILD) $(TARGET).elf $(TARGET).nds $(ROOTDIR)/balatro.nds $(ROOTDIR)/balatro_hb.nds $(BUILD)/balatro_legacy.nds $(BUILD)/balatro_legacy.elf

else

DEPENDS := $(OFILES:.o=.d)

$(OUTPUT).nds: $(OUTPUT).elf
	@echo [NDSTOOL] Packaging $(notdir $@)...
	@ndstool -c $@ -h 0x200 -9 $< $(_ARM7_ELF) -b $(GAME_ICON) "$(GAME_TITLE);$(GAME_SUBTITLE1);$(GAME_SUBTITLE2)" $(_ADDFILES)
	@cp -f $@ $(ROOTDIR)/balatro.nds
	@cp -f $@ $(ROOTDIR)/balatro_hb.nds
	@echo [SUCCESS] Built $(notdir $@), balatro.nds, and balatro_hb.nds for Nintendo DS / DSi / 3DS!

$(OUTPUT).elf: $(OFILES)

-include $(DEPENDS)

endif
